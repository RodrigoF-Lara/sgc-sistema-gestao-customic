{
  "cleanUrls": true,
  "functions": {
    "api/embalagem/relatorios.js": {
      "maxDuration": 60
    },
    "api/embalagem/inventarioCiclico.js": {
      "maxDuration": 60
    },
    "api/embalagem/inventory.js": {
      "maxDuration": 60
    },
    "api/shared/config.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "/api/comercial/pedidos", "destination": "/api/shared/config?tipo=pedidoCapa" },
    { "source": "/api/comercial/depara", "destination": "/api/shared/config?tipo=capaDePara" },
    { "source": "/api/design/mockups/finalizados/foto", "destination": "/api/shared/config?tipo=mockups&acao=integracao-foto" },
    { "source": "/api/design/mockups/finalizados", "destination": "/api/shared/config?tipo=mockups&acao=integracao" },
    { "source": "/api/design/mockups", "destination": "/api/shared/config?tipo=mockups" },
    { "source": "/api/projetos/kanban", "destination": "/api/shared/config?tipo=projetos" },
    { "source": "/widget/capa.js", "destination": "/modules/comercial/widget/loader.js" },
    { "source": "/widget/capa", "destination": "/modules/comercial/widget/embed.html" }
  ]
}
